# ---------------------------------------------------------------------------
# Lab Chat Bot - optional SharePoint connection
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values to make the chatbot answer
# from documents kept in a SharePoint document library.
#
# If you leave these blank, the chatbot simply uses the local "reference/"
# folder instead - it still works without any of this.
#
# Ask your Microsoft 365 / SharePoint administrator for these values. They come
# from an "app registration" in the Microsoft Entra (Azure AD) admin center with
# the "Sites.Read.All" application permission granted.
# ---------------------------------------------------------------------------

# The directory (tenant) ID of your Microsoft 365 organisation.
SHAREPOINT_TENANT_ID=

# The application (client) ID of the app registration.
SHAREPOINT_CLIENT_ID=

# The client secret value created for that app registration.
SHAREPOINT_CLIENT_SECRET=

# Your SharePoint hostname, for example: contoso.sharepoint.com
SHAREPOINT_SITE_HOSTNAME=

# The path to the site that stores the files, for example: /sites/LabTeam
SHAREPOINT_SITE_PATH=

# Optional: a sub-folder inside the document library to read from, for example:
# Knowledge Base. Leave blank to read the whole library.
SHAREPOINT_FOLDER=

# Optional: change the web server port (defaults to 5000).
# PORT=5000
